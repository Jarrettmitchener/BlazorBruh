@page "/"
@using BlazorBruh.Models
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<EditForm Model="Model" OnSubmit="Submit">
    <DynamicList @ref="_listRef" TItem="FlowModel" ItemTemplate="RenderPerson" />

    <button type="button" @onclick="() => _listRef.AddItem(new FlowModel())">
        Add Person
    </button>
    <button type="button" @onclick="() => _listRef.Clear()">
        Clear
    </button>
    <button>submit</button>
</EditForm>


@code {
    private DynamicList<FlowModel> _listRef = null!;

    public RenderFragment<FlowModel> RenderPerson => item => @<PersonRow Item="item" 
                                                                         OnMoveUp="HandleMoveUp"
                                                                         OnMoveDown="HandleMoveDown"
                                                                         OnRemove="HandleRemove" />;
    
    private void HandleRemove(FlowModel item) => _listRef.RemoveItem(item);
    private void HandleMoveUp(FlowModel item) => _listRef.MoveUp(item);
    private void HandleMoveDown(FlowModel item) => _listRef.MoveDown(item);

    public void Submit()
    {
        Model.People = _listRef.Items;
    }

    public FormModel Model { get; set; } = new();
    public class FormModel
    {
        public string Bruh { get; set; }
        public List<FlowModel> People { get; set; } = [];
    }

}