@using BlazorBruh.Models

<div class="card m-3 p-2 bruh">
    <div class="row m-2">
        <div class="col">
            <InputText @bind-Value="@Item.Name" class="form-control"></InputText>
            <ValidationMessage For="@(() => Item.Name)" />
        </div>
    </div>
    <div class="row m-2">
        <div class="col">
            <InputDate @bind-Value="Item.Time"></InputDate>
            <ValidationMessage For="@(() => Item.Time)" />
        </div>
        <div class="col">
            <InputNumber @bind-Value="Item.Price"></InputNumber>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Event Item { get; set; } = null!;
    [Parameter] public EventCallback<Event> OnRemove { get; set; }
    [Parameter] public EventCallback<Event> OnMoveUp { get; set; }
    [Parameter] public EventCallback<Event> OnMoveDown { get; set; }

    protected override void OnInitialized()
    {
        Item.Time = DateTime.Now;
    }

}