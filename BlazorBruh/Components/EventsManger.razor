@page "/events"
@rendermode InteractiveServer
@using BlazorBruh.Models
@using Blazilla
@using FluentValidation
<h3>EventsManger</h3>

<EditForm Model="Model" OnValidSubmit="Submit">
    <FluentValidator />
    <InputText @bind-Value="Model.Timeline"></InputText>
    <ValidationMessage For="@(() => Model.Timeline)" />
    
    <DynamicList @ref="_listRef" TItem="Event" Items="Model.Events" ItemTemplate="RenderPerson"/>

    <button type="button" @onclick="() => _listRef.AddItem(new Event())">
        Add Person
    </button>
    <button type="button" @onclick="() => _listRef.Clear()">
        Clear
    </button>
    <button>submit</button>
</EditForm>

@code {
    private DynamicList<Event> _listRef = null!;

    public RenderFragment<Event> RenderPerson => item => @<EventRow Item="item" 
                                                                         OnMoveUp="HandleMoveUp"
                                                                         OnMoveDown="HandleMoveDown"
                                                                         OnRemove="HandleRemove" />;
    
    private void HandleRemove(Event item) => _listRef.RemoveItem(item);
    private void HandleMoveUp(Event item) => _listRef.MoveUp(item);
    private void HandleMoveDown(Event item) => _listRef.MoveDown(item);

    public void Submit()
    {
        Model.Events = _listRef.Items;
    }

    public FormModel Model { get; set; } = new();
    public class FormModel
    {
        public string Timeline { get; set; } = string.Empty;
        public List<Event> Events { get; set; } = [];
    }

    public class FormModelValidator : AbstractValidator<FormModel>
    {
        public FormModelValidator()
        {
            RuleFor(form => form.Timeline).NotEmpty().WithMessage("Timeline is required");
            RuleForEach(form => form.Events).ChildRules(order =>
            {
                order.RuleFor(x => x.Name).NotEmpty();
            });
        }
    }
}